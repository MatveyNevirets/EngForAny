# Demo is always used until the server adapter is explicitly implemented.
# These values alone DO NOT enable delivery.
MAX_BOT_TOKEN=
MAX_RECIPIENT_ID=
# Choose user_id OR chat_id after confirming the real bot recipient.
MAX_RECIPIENT_TYPE=user_id

# Keep false until content, consent, policy and delivery have been approved.
ALLOW_INDEXING=false
# Optional absolute custom domain, e.g. https://example.ru.
# On Netlify this can stay empty: DEPLOY_PRIME_URL / URL are used automatically.
SITE_URL=
